         <property name="styleSheet">
          <string notr="true">/* 基础蓝色字体Label */
QLabel {
    color: #4a90e2; /* 主色调蓝色（与之前控件交互色一致） */
    font-size: 16px; /* 统一文字大小 */
    padding: 4px 6px; /* 轻微内边距 */
    background-color: transparent; /* 透明背景，不破坏布局 */
	font-weight: bold
}

/* 禁用状态（蓝色变浅灰） */
QLabel:disabled {
    color: #b3c8e8; /* 禁用时的浅蓝灰色 */
}

/* 链接样式（加深蓝色） */
QLabel::link {
    color: #3a80d2; /* 比普通文字更深的蓝色 */
    text-decoration: none; /* 去除默认下划线 */
}

/* 链接悬停 */
QLabel::link:hover {
    color: #2a70c2; /* 悬停时更深的蓝色 */
    text-decoration: underline; /* 下划线提示 */
}

/* 强调型蓝色Label（可通过objectName使用） */
QLabel#highlightLabel {
    color: #2d7dcb; /* 更深的蓝色 */
    font-weight: bold; /* 加粗强调 */
    font-size: 15px;
}

/* 浅色蓝色Label（辅助文本） */
QLabel#lightLabel {
    color: #7aaae0; /* 较浅的蓝色 */
    font-size: 13px;
}</string>
