       <item row="0" column="2">
        <widget class="QComboBox" name="comboBox_port">
         <property name="minimumSize">
          <size>
           <width>128</width>
           <height>30</height>
          </size>
         </property>
         <property name="font">
          <font>
           <family>宋体</family>
