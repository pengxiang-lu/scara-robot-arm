      <property name="styleSheet">
       <string notr="true">/* GroupBox整体样式 */
QGroupBox {
    background-color: transparent; /* 透明背景，融入整体 */
    border: 2px solid #ddd; /* 浅灰边框，与下拉框边框一致 */
    border-radius: 4px; /* 统一圆角 */
    margin-top: 8px; /* 顶部预留标题空间 */
    padding: 16px 8px 8px 8px; /* 内边距（上右下左） */
    color: #333333; /* 文字颜色 */
    font-size: 20px;
	font-weight: bold;
}


/* 禁用状态 */
QGroupBox:disabled {
    border-color: blue; /* 更浅的边框 */
    color: #999999; /* 禁用文字色 */
}

/* 带标题的GroupBox激活状态（可选） */
QGroupBox:checked {
    border-color: #4a90e2; /* 激活时边框用主色 */
}

/* 激活状态的标题（可选，用于带复选框的GroupBox） */
QGroupBox:checked::title {
    color: #4a90e2; /* 激活时标题用主色 */
}</string>
      </property>
      <property name="title">
       <string>串口通信：</string>
      </property>
