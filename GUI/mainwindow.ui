       <item row="4" column="5">
        <widget class="QPushButton" name="pushButton_sendVoice">
         <property name="minimumSize">
          <size>
           <width>100</width>
           <height>30</height>
          </size>
         </property>
         <property name="maximumSize">
          <size>
           <width>100</width>
           <height>30</height>
          </size>
         </property>
         <property name="font">
          <font>
           <family>楷体</family>
           <pointsize>-1</pointsize>
           <bold>true</bold>
          </font>
         </property>
         <property name="styleSheet">
          <string notr="true">/* 正常状态按钮 */
QPushButton {
    /* 基础样式 */
    background-color: #4a90e2; /* 背景色 */
    color: white;              /* 文字颜色 */
    border-radius: 6px;        /* 圆角半径 */
    border: none;              /* 去除默认边框 */
    padding: 6px 16px;         /* 内边距（上下 左右） */
    font-size: 16px;           /* 文字大小 */
}

/* 悬停状态（鼠标放在按钮上） */
QPushButton:hover {
    background-color: #5b9def; /* 稍亮的背景色 */
}

/* 按下状态（鼠标点击按钮时） */
QPushButton:pressed {
    background-color: #3a80d2; /* 稍暗的背景色 */
    padding: 7px 15px 5px 17px; /* 模拟按下的位移效果 */
}

/* 禁用状态 */
QPushButton:disabled {
    background-color: #cccccc; /* 灰色背景 */
    color: #999999;            /* 灰色文字 */
}

/* 带图标按钮的额外样式（可选） */
QPushButton[icon]:not([text=&quot;&quot;]) {
    padding-left: 28px; /* 为图标预留空间 */
}</string>
         </property>
