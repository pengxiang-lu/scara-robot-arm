           <bold>false</bold>
          </font>
         </property>
         <property name="styleSheet">
          <string notr="true">/* 下拉框整体样式 */
QComboBox {
    background-color: white;      /* 白色背景 */
    color: #333333;               /* 深灰文字 */
    border-radius: 6px;           /* 统一圆角 */
    border: 1px solid #ddd;       /* 浅灰边框 */
    padding: 6px 30px 6px 16px;   /* 内边距（预留箭头空间） */
    font-size: 14px;              /* 文字大小 */
    min-width: 80px;             /* 最小宽度 */
}

/* 下拉框悬停状态 */
QComboBox:hover {
    border-color: #4a90e2;        /* 边框变主色（与按钮hover呼应） */
    background-color: #f9f9f9;    /* 轻微灰调 */
}

/* 下拉框被激活（展开时） */
QComboBox:on {
    border-color: #4a90e2;        /* 激活状态边框色 */
    background-color: #f5f5f5;    /* 稍暗背景 */
    border-radius: 6px 6px 0 0;   /* 顶部保持圆角 */
}

/* 下拉框禁用状态 */
QComboBox:disabled {
    background-color: #f5f5f5;    /* 禁用背景 */
    color: #999999;               /* 禁用文字色 */
    border-color: #eee;           /* 禁用边框 */
}

/* 下拉箭头样式 */
QComboBox::down-arrow {
    image: url(:/icons/gray_arrow.png); /* 灰色箭头（可替换为深色图标） */
    width: 16px;
    height: 16px;
}

/* 箭头区域 */
QComboBox::drop-down {
    border: none;
    width: 30px;
    background-color: transparent; /* 透明背景，与主区域融合 */
}

/* 下拉列表框样式 */
QComboBox QAbstractItemView {
    background-color: white;      /* 列表白色背景 */
    color: #333;                  /* 列表文字色 */
    border: 1px solid #ddd;       /* 列表边框 */
    border-top: none;             /* 与下拉框衔接处无边框 */
    border-radius: 0 0 6px 6px;   /* 底部圆角 */
    padding: 4px;
    selection-background-color: #4a90e2; /* 选中项主色背景 */
    selection-color: white;       /* 选中项文字白 */
    font-size: 14px;
}

/* 列表项悬停 */
QComboBox QAbstractItemView::item:hover {
    background-color: #f0f5ff;    /* 浅蓝悬停色 */
}

/* 列表项选中但未激活 */
QComboBox QAbstractItemView::item:selected:!active {
    background-color: #e6f0ff;    /* 稍浅的选中色 */
}</string>
         </property>
        </widget>
